# Copy this file to `.env` and fill in your values. `.env` is gitignored.
# docker compose reads `.env` automatically and substitutes the ${VAR} refs
# in docker-compose.yml.

# --- Video summary tool (/#/summary) ---
# Required. Without it the summary tool returns 503.
# Default provider is DeepSeek (OpenAI-compatible); use any compatible endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat
OPENAI_TIMEOUT=60
# Per-chunk subtitle char budget for long-video map-reduce summarization.
SUMMARY_MAX_INPUT_CHARS=9000

# --- Bilibili (optional, improves reliability of download + subtitle fetch) ---
# Either drop a Netscape cookies file at ./cookies/bilibili.cookies.txt, or set
# a raw browser Cookie header here:
# BILIBILI_COOKIE_HEADER=SESSDATA=...; bili_jct=...; DedeUserID=...

# --- Lecture exercises (/#/exercises) ---
# Server-selected model. Change this and recreate the container to switch.
# sensevoice (default), qwen3, or whisper
ASR_BACKEND=sensevoice
# New models use ModelScope by default; alternatively use huggingface.
ASR_MODEL_SOURCE=modelscope
ASR_DEVICE=cpu
ASR_CPU_THREADS=4
ASR_SEGMENT_SECONDS=25
SENSEVOICE_MODEL=iic/SenseVoiceSmall
QWEN_ASR_MODEL=Qwen/Qwen3-ASR-0.6B-hf
# These two variables also accept absolute paths to local model directories.
# Both Chinese models use this small VAD model to retain video segment times.
ASR_VAD_MODEL=iic/speech_fsmn_vad_zh-cn-16k-common-pytorch
# Persistent cache; default DATA_DIR/models.
# ASR_MODEL_DIR=/data/models
# Whisper compatibility mode: local CPU inference, INT8.
# Can also be an absolute path to a converted CTranslate2 model directory.
WHISPER_MODEL=small
# Default download mirror. Use https://huggingface.co for the official Hub.
HF_ENDPOINT=https://hf-mirror.com
# Disable Xet/CAS reconstruction to avoid xethub.hf.co 401 with mirrors.
# Must be set before starting the Python process.
HF_HUB_DISABLE_XET=1
WHISPER_CPU_THREADS=4
# Chunk budget for complete lecture knowledge extraction.
EXERCISE_MAX_INPUT_CHARS=9000
# Optional persistent model cache (default DATA_DIR/models).
# WHISPER_MODEL_DIR=/data/models
